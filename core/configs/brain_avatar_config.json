{
  "active_voice_engine": "edge",
  "commands_show_customization": {
    "query_log": {
      "animation": "<default>",
      "hiden_on_muted": true,
      "level": "informative",
      "pre_processor": "<default>",
      "show_message": true,
      "speak_message": true
    }
  },
  "ignore_quota_state": true,
  "reactions": [
    {
      "animation": "reacting",
      "message": "Reaccionando al dobleclick"
    }
  ],
  "service": {
    "host": "127.0.0.1",
    "port": 20772
  },
  "silent_commands": [
    "query",
    "query-log",
    "list-profiles",
    "set-task-status"
  ],
  "tts_chunks_size": 2000,
  "voice_engines": {
    "edge": {
      "pitch": "+0Hz",
      "rate": "+0%",
      "sanitization_regex": "_+",
      "voices": {
        "en": "en-US-AriaNeural",
        "es": "es-ES-ElviraNeural"
      },
      "volume": "+0%"
    },
    "elevenlabs": {
      "api_key": "$ELEVENLABS_API_KEY",
      "model_id": "eleven_flash_v2_5",
      "model_id_": "eleven_multilingual_v2",
      "voice_id": "<VOICE_ID>",
      "voices": {
        "en": "<VOICE_ID>",
        "es": "<VOICE_ID>"
      }
    },
    "openai": {
      "api_key": "$OPENAI_API_KEY",
      "model": "tts-1",
      "voice": "shimmer",
      "voices": {
        "en": "shimmer",
        "es": "shimmer"
      }
    },
    "pyttsx3": {
      "rate": 150,
      "voices": {
        "en": "english",
        "es": "spanish"
      },
      "volume": 1.0
    }
  }
}
